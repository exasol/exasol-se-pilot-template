.DS_Store
**/.DS_Store

# VS Code local startup task logs — generated per developer workstation
.vscode/startup-logs/

# Exasol Personal deployment — contains Terraform state and credentials
exasol-deployment/
exasol-deployment-<AWS_REGION>/
exasol-deployment-*/
exasol-redeployment-*/
exasol-redeployment/

# Streamlit dashboard runtime artefacts (env, venv, caches)
services/streamlit-insights/.env
services/streamlit-insights/.venv/
services/streamlit-insights/__pycache__/
services/streamlit-insights/*.log
scheduler/lambda_function.zip
.claude/
scheduler/*.zip
tests/logs/runs/*/.pids

# Python bytecode caches — generated by `python -c` runs on the
# developer Mac when importing Lambda / helper modules. Environment-
# specific, never useful in git. Catches scheduler/__pycache__/,
# scripts/__pycache__/, and any future ones.
**/__pycache__/
*.pyc
*.pyo

# graceful-stop validation package — build/run artifacts (keep the package + JSON reports)
scripts/exasol_stop_tests*.zip
scripts/exasol_stop_tests/run-*.log
**/__pycache__/
