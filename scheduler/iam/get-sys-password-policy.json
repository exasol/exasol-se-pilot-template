{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyOnExasolSysSecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:eu-central-1:<AWS_ACCOUNT_ID>:secret:<PROJECT_SLUG>/exasol-sys-*"
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:eu-central-1:<AWS_ACCOUNT_ID>:log-group:/aws/lambda/<PROJECT_SLUG>-get-sys-password*"
    }
  ]
}
