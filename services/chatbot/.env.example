# <PILOT_NAME> Chatbot — copy to .env on EC2 (mode 600), never in git.
#
# Most secrets are sourced at runtime from AWS (Bedrock via IAM role,
# GitHub PAT via SSM Parameter Store). The Cognito client secret is
# the one secret that stays in the env file — it's used in a single
# OAuth-token-exchange call so we tolerate it here.

COGNITO_DOMAIN=https://<PROJECT_SLUG>-mcp-<AWS_ACCOUNT_ID>.auth.eu-central-1.amazoncognito.com
COGNITO_CLIENT_ID=3brunjmf3l8gj6fb093c7fuiu
COGNITO_CLIENT_SECRET=<get from secret — never in git>
APP_REDIRECT_URI=https://<PROJECT_SLUG>-chat.<PILOT_DOMAIN>/

BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6
GITHUB_REPO=<GITHUB_REPOSITORY>
SSM_PAT_NAME=/<PROJECT_SLUG>/chatbot/github-token
