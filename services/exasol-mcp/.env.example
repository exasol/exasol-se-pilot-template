# <CUSTOMER_NAME> MCP stack — Exasol connection + OAuth proxy for the remote MCP server.
# Copy to `.env` (gitignored) on the host before `docker compose up`.
#
# The hardening doc has the full rationale + recreation commands:
#   docs/30-runbooks/mcp/XYZ_MCP_PRODUCTION_HARDENING.md

# --- Database ---
EXA_DSN=<EXASOL_HOSTNAME>:8563
EXA_USER=xyz_dash
EXA_PASSWORD=<request from Thomas / read from /tmp/pilot_dash_password.txt>
# Exasol Personal ships with a self-signed TLS certificate; the MCP
# server's pyexasol underneath will refuse to connect unless we skip
# CA-validation explicitly.
EXA_SSL_CERT_VALIDATION=false

# --- OAuth (AWS Cognito hosted UI) — XYZ-PILOT-035 ---
# Drop --no-auth in docker-compose. The Exasol image bundles FastMCP's
# built-in AWSCognitoProvider; it auto-discovers via OIDC and validates
# every MCP call against a Cognito-issued JWT.
#
# Env-var convention is `FASTMCP_SERVER_AUTH_AWS_COGNITO_*` (verified
# against exasol-mcp-server:1.7.0 — the upstream README example with
# `exa.fastmcp.server.auth.oauth_proxy.OAuthProxy` is for a different
# version and does not work here).
FASTMCP_SERVER_AUTH=fastmcp.server.auth.providers.aws.AWSCognitoProvider
FASTMCP_SERVER_AUTH_AWS_COGNITO_USER_POOL_ID=<COGNITO_USER_POOL_ID>
FASTMCP_SERVER_AUTH_AWS_COGNITO_AWS_REGION=eu-central-1
FASTMCP_SERVER_AUTH_AWS_COGNITO_CLIENT_ID=<from Cognito app-client>
FASTMCP_SERVER_AUTH_AWS_COGNITO_CLIENT_SECRET=<from Cognito app-client, never in git>
FASTMCP_SERVER_AUTH_AWS_COGNITO_BASE_URL=https://<PROJECT_SLUG>.<PILOT_DOMAIN>
FASTMCP_SERVER_AUTH_AWS_COGNITO_REDIRECT_PATH=/auth/callback

# --- Logging ---
EXA_MCP_LOG_LEVEL=INFO
EXA_MCP_LOG_TO_CONSOLE=true

# --- Public SQL tool guardrails (XYZ-PILOT-145) ---
# The compose file supplies EXA_MCP_SETTINGS so the public server keeps metadata
# tools, enables view discovery, and leaves the upstream uncapped read-query
# registration disabled. The custom entrypoint adds capped aliases:
# exasol_query, execute_read_only_sql, and run_exasol_query.
xyz_mcp_sql_max_rows=200
xyz_mcp_sql_max_chars=12000
