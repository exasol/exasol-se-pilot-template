GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GF_SERVER_ROOT_URL=http://localhost:3000
PROXY_TOKEN=

EXASOL_HOST=host.docker.internal
EXASOL_PORT=8563
EXASOL_USER=XYZ_DASH
EXASOL_PASSWORD=
EXASOL_SCHEMA=<PILOT_SCHEMA>

# Optional: enable dynamic ConfD license details in the Exasol monitor dashboard.
EXASOL_LICENSE_NODE=
EXASOL_LICENSE_SSH_KEY_PATH=
EXASOL_LICENSE_REFRESH_ON_STARTUP=1
EXASOL_LICENSE_TIMEOUT_SECONDS=90
